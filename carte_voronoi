import json
import numpy as np
import folium
from scipy.spatial import Delaunay, Voronoi
from collections import defaultdict
import math

# Chargement des données
with open("velib_coordonnées.json", encoding="utf-8") as f:
    coords = json.load(f)

with open("velib_stations.json", encoding="utf-8") as f:
    stations_info = json.load(f)

# Dictionnaires utiles
coord_to_id = {(s['lat'], s['lon']): str(s['station_id']) for s in coords}
id_to_coord = {str(s['station_id']): (s['lat'], s['lon']) for s in coords}
id_to_capacity = {str(s['station_id']): s['capacity'] for s in stations_info}

# Points pour Delaunay
points = np.array([(s['lat'], s['lon']) for s in coords])
tri = Delaunay(points)

# Construction de la liste d’adjacence
adjacence = defaultdict(set)
edges = set()
for simplex in tri.simplices:
    for i in range(3):
        for j in range(i + 1, 3):
            idx1, idx2 = simplex[i], simplex[j]
            id1 = coord_to_id[tuple(points[idx1])]
            id2 = coord_to_id[tuple(points[idx2])]
            adjacence[id1].add(id2)
            adjacence[id2].add(id1)
            lat1, lon1 = points[idx1]
            lat2, lon2 = points[idx2]
            dist = math.dist((lat1, lon1), (lat2, lon2))
            edges.add((dist, id1, id2))

# Calcul des indices de répartition : indice = capacité / nombre de voisins
indices = {}
for station_id in adjacence:
    capacite = id_to_capacity.get(station_id, 0)
    voisins = len(adjacence[station_id])
    indice = capacite / voisins if voisins != 0 else 0
    indices[station_id] = indice

# Couleurs selon le seuil de 6 retenu dans le projet.
def get_color(indice):
    if indice < 6:
        return "#ff0000"  # rouge
    elif indice == 6:
        return "#00ff00"  # vert
    else:
        return "#0000ff"  # bleu

# Création de la carte
m = folium.Map(location=[48.8566, 2.3522], zoom_start=12)
m.fit_bounds([points.min(axis=0).tolist(), points.max(axis=0).tolist()], padding=(20, 20))
cellules = folium.FeatureGroup(name="Cellules de Voronoï").add_to(m)
triangles = folium.FeatureGroup(name="Triangulation de Delaunay", show=False).add_to(m)
arbre = folium.FeatureGroup(name="Arbre couvrant (Kruskal)", show=False).add_to(m)
stations = folium.FeatureGroup(name="Stations", show=False).add_to(m)

# Triangles de Delaunay en vert
for simplex in tri.simplices:
    p1, p2, p3 = points[simplex]
    folium.PolyLine([p1, p2, p3, p1], color="green", weight=1, opacity=0.4).add_to(triangles)

# Arbre couvrant minimum (Kruskal)
parent = {s: s for s in adjacence}

def find(x):
    if parent[x] != x:
        parent[x] = find(parent[x])
    return parent[x]

def union(x, y):
    rootX = find(x)
    rootY = find(y)
    if rootX != rootY:
        parent[rootY] = rootX

sorted_edges = sorted(edges)
acm_edges = []
for dist, a, b in sorted_edges:
    if find(a) != find(b):
        union(a, b)
        acm_edges.append((a, b))

for a, b in acm_edges:
    folium.PolyLine([id_to_coord[a], id_to_coord[b]], color="black", weight=1.5).add_to(arbre)

# Ajout des cellules de Voronoi selon l'indice de répartition
vor_points = np.array([[s["lon"], s["lat"]] for s in coords])
vor = Voronoi(vor_points)
coord_to_id_voronoi = {(s["lat"], s["lon"]): str(s["station_id"]) for s in coords}

for point_idx, region_idx in enumerate(vor.point_region):
    region = vor.regions[region_idx]
    if -1 in region or len(region) == 0:
        continue
    polygon = [vor.vertices[i] for i in region]
    polygon_latlon = [[lat, lon] for lon, lat in polygon]
    lat, lon = vor_points[point_idx][1], vor_points[point_idx][0]
    station_id = coord_to_id_voronoi.get((lat, lon))
    if not station_id or station_id not in indices:
        continue
    couleur = get_color(indices[station_id])
    folium.Polygon(
        locations=polygon_latlon,
        color=couleur,
        fill=True,
        fill_color=couleur,
        fill_opacity=0.16,
        weight=1
    ).add_to(cellules)

# Ajout des stations avec tooltip détaillé
for station in stations_info:
    if "lat" in station and "lon" in station:
        station_id = str(station["station_id"])
        indice_rep = indices.get(station_id, 0)
        color = get_color(indice_rep)
        folium.CircleMarker(
            location=[station['lat'], station['lon']],
            radius=5,
            color=color,
            fill=True,
            fill_color=color,
            fill_opacity=0.7,
            tooltip=(
                f"{station.get('name', 'Inconnu')}<br>"
                f"Capacité: {station.get('capacity', 0)}<br>"
                f"Capacité / nombre de voisines : {indice_rep:.3f}"
            )
        ).add_to(stations)

# Ajout de la légende conforme à la définition
legend_html = """
<div style="
    position: fixed;
    bottom: 28px; left: 12px; width: 285px; max-width: calc(100% - 44px);
    background-color: white; z-index:9999;
    border:2px solid grey; padding:10px; font-size:14px;">
<b>Légende :</b><br>
<span style='color:green;'>─</span> Triangle de Delaunay<br>
<span style='color:black;'>─</span> Arbre couvrant minimum (Kruskal)<br>
<span style='color:red;'>●</span> Ratio capacité / voisines &lt; 6<br>
<span style='color:green;'>●</span> Ratio capacité / voisines = 6<br>
<span style='color:blue;'>●</span> Ratio capacité / voisines &gt; 6<br>
</div>
"""
m.get_root().html.add_child(folium.Element(legend_html))
folium.LayerControl(collapsed=False).add_to(m)

# Sauvegarde de la carte
m.save("velib_stations_voronoi.html")
